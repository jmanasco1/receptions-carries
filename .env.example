# Copy to .env and fill in. .env is gitignored and must never be committed.

# The Odds API key -- https://the-odds-api.com/
# Free tier is 500 credits/month. See README for the credit budget.
ODDS_API_KEY=

# Optional: override the data directory from config.toml
# NFL_PROPS_DATA_DIR=/absolute/path/to/data

# Optional: override the config file location
# NFL_PROPS_CONFIG=/absolute/path/to/config.toml
